        <tei:body>
            <tei:div type="edition" subtype="interpretative" xml:space="preserve">
                <tei:div type="textpart" n="face_a" style="text-direction:r-to-l" rend="ductus:sinistrorse">
                    <tei:ab>                                
                        <tei:lb n="1" xml:id="Fal_52_l_1"/>
                        <!-- Leida;Fal_52_l_1_w_1;ca(uia) -->
                        <tei:name type="praenomen" xml:id="Fal_52_l_1_w_1" xml:lang="xfa-Ital-x-xfafal" ref="#p1"><tei:expan><tei:abbr><tei:hi rend="reversed">c</tei:hi>a</tei:abbr><tei:ex>uia</tei:ex></tei:expan></tei:name><tei:pc unit="word">:</tei:pc>
                        <!-- Leida;Fal_52_l_1_w_2;u[eculi]a -->
                        <tei:name type="gentilicium" xml:id="Fal_52_l_1_w_2" xml:lang="xfa-Ital-x-xfafal" ref="#p1">u<tei:supplied reason="lost">eculi</tei:supplied>a</tei:name>
                        <tei:lb n="2" xml:id="Fal_52_l_2"/>
                        <!-- Leida;Fal_52_l_2_w_1;ca(uia) -->
                        <tei:name type="praenomen" xml:id="Fal_52_l_2_w_1" xml:lang="xfa-Ital-x-xfafal" ref="#p2"><tei:expan><tei:abbr>ca</tei:abbr><tei:ex>uia</tei:ex></tei:expan></tei:name><tei:pc unit="word">:</tei:pc>
                        <!-- Leida;Fal_52_l_2_w_2;e[c]nata -->
                        <tei:name type="gentilicium" xml:id="Fal_52_l_2_w_2" xml:lang="xfa-Ital-x-xfafal" ref="#p2">e<tei:supplied reason="lost">c</tei:supplied>nata</tei:name><tei:pc unit="word">:</tei:pc>
                        <!-- Leida;Fal_52_l_2_w_3;θạnia -->
                        <tei:name type="praenomen" xml:id="Fal_52_l_2_w_3" xml:lang="xfa-Ital-x-xfafal" ref="#p3">θ<tei:unclear>a</tei:unclear>nia</tei:name>
                    </tei:ab>
                </tei:div>
            </tei:div>
            <tei:div type="translation" xml:lang="ita">
                <tei:p>Ga(uia) U[eculi]a, Ga(uia) E[g]nata, Thania</tei:p>
                <tei:desc>
                    <tei:persName>Greta Mozzato</tei:persName>
                    <tei:ref type="licence" target="http://creativecommons.org/licenses/by-sa/4.0/">This file is licensed under the Creative Commons Attribution-ShareAlike 4.0 license.</tei:ref>
                </tei:desc>
            </tei:div>
            <tei:div type="translation" xml:lang="eng">
                <tei:p>Ga(uia) U[eculi]a, Ga(uia) E[g]nata, Thania</tei:p>
                <tei:desc>
                    <tei:persName>Greta Mozzato</tei:persName>
                    <tei:ref type="licence" target="http://creativecommons.org/licenses/by-sa/4.0/">This file is licensed under the Creative Commons Attribution-ShareAlike 4.0 license.</tei:ref>
                </tei:desc>
            </tei:div>
            <tei:div type="apparatus" xml:lang="eng" resp="GretaMozzato">
                <tei:listApp>
                    <tei:app from="#Fal_52_l_2_w_2">
                        <tei:lem corresp="#Fal_52_l_2_w_2">e[c]ṇata <tei:ref target="http://zotero.org/groups/2552746/items/NJFZRK23"><tei:bibl>Vetter 1953</tei:bibl></tei:ref>, <tei:ref target="http://zotero.org/groups/2552746/items/84FQ2UI4"><tei:bibl>Bakkum 2009</tei:bibl></tei:ref></tei:lem>
                        <tei:rdg corresp="#Fal_52_l_2_w_2">e[c]nata <tei:ref target="http://zotero.org/groups/2552746/items/USHGF3E7"><tei:bibl>Giacomelli 1963</tei:bibl></tei:ref></tei:rdg>
                    </tei:app>
                    <tei:app from="#Fal_52_l_2_w_3">
                        <tei:lem corresp="#Fal_52_l_2_w_3">θania <tei:ref target="http://zotero.org/groups/2552746/items/84FQ2UI4"><tei:bibl>Bakkum 2009</tei:bibl></tei:ref></tei:lem>
                        <tei:rdg corresp="#Fal_52_l_2_w_3">θ(n)ania <tei:ref target="http://zotero.org/groups/2552746/items/NJFZRK23"><tei:bibl>Vetter 1953</tei:bibl></tei:ref></tei:rdg>
                        <tei:rdg corresp="#Fal_52_l_2_w_3">θạnia <tei:ref target="http://zotero.org/groups/2552746/items/USHGF3E7"><tei:bibl>Giacomelli 1963</tei:bibl></tei:ref></tei:rdg>
                    </tei:app>
                </tei:listApp>
            </tei:div>
            <tei:div type="commentary" xml:lang="eng" resp="GretaMozzato">
                <tei:note target="#Fal_52_l_1_w_1">
                    <tei:p>The letter c in <tei:rs corresp="#Fal_52_l_1_w_1" xml:lang="xfa-Ital-x-xfafal">ca</tei:rs> is dextroverse and should indicate a woman's name (for the discussion see for example <tei:ref target="http://zotero.org/groups/2552746/items/84FQ2UI4"><tei:bibl>Bakkum 2009</tei:bibl></tei:ref>)</tei:p> 
                </tei:note>
                <tei:note target="Fal_52_l_1_w_2">
                    <tei:p>The gentilicium <tei:rs corresp="#Fal_52_l_1_w_2" xml:lang="xfa-Ital-x-xfafal">u[eculi]a</tei:rs> was restored from comparison with <tei:rs corresp="Fal_51_l_2_w_1" xml:lang="xfa-Ital-x-xfafal">[u]eculia</tei:rs> in Ve 281 a/Giacomelli 79 I/Bakkum 80</tei:p>
                </tei:note>
                <tei:note target="Fal_52_l_2_w_2">
                    <tei:p>The restoretion <tei:rs corresp="#Fal_52_l_2_w_2" xml:lang="xfa-Ital-x-xfafal">e[c]ṇata</tei:rs> was suggested by <tei:ref target="http://zotero.org/groups/2552746/items/UBUNXDWJ"><tei:bibl>Garrucci 1864</tei:bibl></tei:ref></tei:p>
                </tei:note>
                <tei:note target="Fal_52">
                    <tei:p>According to <tei:ref target="http://zotero.org/groups/2552746/items/UBUNXDWJ"><tei:bibl>Garrucci 1864</tei:bibl></tei:ref> the inscription pertains to the burial of two woman, respectively Gauia Ueculia and Gauia Egnata Thania; in this case, Thania should be considered as a matronymic. <tei:ref target="http://zotero.org/groups/2552746/items/NJFZRK23"><tei:bibl>Vetter 1953</tei:bibl></tei:ref> argued that the second <tei:rs corresp="Fal_52_l_2_w_1" xml:lang="xfa-Ital-x-xfafal">ca</tei:rs> could not be the abbreviation of a woman's name, instead it should be an abbreviation of a man's name like Gauio. Thus, he suggested that the inscription pertains to the burial of a woman (Gauia Ueculia) and her three slaves (Gauio, Egnata, Thania). Later this suggestion was adopted by <tei:ref target="http://zotero.org/groups/2552746/items/USHGF3E7"><tei:bibl>Giacomelli 1963</tei:bibl></tei:ref>. A third suggestion was proposed by <tei:ref target="http://zotero.org/groups/2552746/items/84FQ2UI4"><tei:bibl>Bakkum 2009</tei:bibl></tei:ref>: according to him the burial pertains to three women, respectively Gauia Ueculia, Gauia Egnata and Thania</tei:p>
                </tei:note>
                    <tei:listPerson type="Onomastics">
                        <tei:person xml:id="p1" xml:lang="xfa-Ital-x-xfafal">
                            <tei:persName>
                                <tei:name type="praenomen">ca(uia)</tei:name>
                                <tei:name type="gentilicium">u[eculi]a</tei:name>
                            </tei:persName>
                        </tei:person>
                        <tei:person xml:id="p2" xml:lang="xfa-Ital-x-xfafal">
                            <tei:persName>
                                <tei:name type="praenomen">ca(uia)</tei:name>
                                <tei:name type="gentilicium">e[c]ṇata</tei:name>
                            </tei:persName>
                        </tei:person>
                        <tei:person xml:id="p3" xml:lang="ett-Ital">
                            <tei:persName>
                                <tei:name type="praenomen">θania</tei:name>
                            </tei:persName>
                        </tei:person>
                    </tei:listPerson>
            </tei:div>
