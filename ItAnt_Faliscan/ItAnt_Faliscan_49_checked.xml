                            <tei:name type="gentilicium" xml:id="Fal_49_l_1_w_2" xml:lang="xfa-Ital-x-xfafal" ref="#p1">colanioi</tei:name>
                        <tei:lb n="2" xml:id="Fal_49_l_2"/>
                        <!-- Leida;Fal_49_l_2_w_1;tulom -->
                            <tei:name type="praenomen" xml:id="Fal_49_l_2_w_1" xml:lang="xfa-Ital-x-xfafal" ref="#p2">tulom</tei:name>
