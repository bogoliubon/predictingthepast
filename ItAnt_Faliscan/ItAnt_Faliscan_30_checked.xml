                        <tei:w xml:id="Fal_30_l_1_w_1">ue<tei:unclear>n</tei:unclear>e<tei:gap reason="lost" extent="unknown" unit="character"></tei:gap></tei:w>
                        <!-- Leida;Fal_30_l_1_w_2;]na -->
