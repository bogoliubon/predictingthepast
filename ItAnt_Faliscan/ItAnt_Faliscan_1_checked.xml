        <tei:body>
            <tei:div type="edition" subtype="interpretative" xml:space="preserve">
                <tei:div type="textpart" n="face_a" style="text-direction:r-to-l" rend="ductus:sinistrorse">
                    <tei:ab>                                   
                        <tei:lb n="1" xml:id="Fal_1_l_1"/>
                        <!-- Leida;Fal_1_l_1_w_1;eko -->
                            <tei:w xml:id="Fal_1_l_1_w_1" xml:lang="xfa-Ital-x-xfafal">eko</tei:w>
                        <!-- Leida;Fal_1_l_1_w_2;lartos -->
                            <tei:name type="praenomen" xml:id="Fal_1_1_1_w_2" xml:lang="xfa-Ital-x-xfafal" ref="#p1">lartos</tei:name> 
                        <tei:lb n="2" xml:id="Fal_1_l_2"/> 
                        <!-- Leida;Fal_1_l_2_w_1;eko -->
                            <tei:w xml:id="Fal_1_l_2_w_1" xml:lang="xfa-Ital-x-xfafal">eko</tei:w>
                        <!-- Leida;Fal_1_l_2_w_2;kaisiosio --> 
                            <tei:name type="praenomen" xml:id="Fal_1_l_2_w_2" xml:lang="xfa-Ital-x-xfafal" ref="#p2">kaisiosio</tei:name>
                    </tei:ab>
                </tei:div>
            </tei:div>
            <tei:div type="translation" xml:lang="ita">
                <tei:p>Io (sono) di Lart</tei:p>
                <tei:p>Io (sono) di Kaisio</tei:p>
                <tei:desc>
                    <tei:persName>Greta Mozzato</tei:persName>
                    <tei:ref type="licence" target="http://creativecommons.org/licenses/by-sa/4.0/">This file is licensed under the Creative Commons Attribution-ShareAlike 4.0 license.</tei:ref>
                </tei:desc>
            </tei:div>
            <tei:div type="translation" xml:lang="eng">
                <tei:p>I (am) of Lart</tei:p>
                <tei:p>I (am) of Kaisio</tei:p>
                <tei:desc>
                    <tei:persName>Greta Mozzato</tei:persName>
                    <tei:ref type="licence" target="http://creativecommons.org/licenses/by-sa/4.0/">This file is licensed under the Creative Commons Attribution-ShareAlike 4.0 license.</tei:ref>
                </tei:desc>
            </tei:div>
            <tei:div type="commentary" xml:lang="eng" resp="GretaMozzato">
                <tei:note target="#Fal_1_l_1, #Fal_1_l_2">
                    <tei:p>As suggested by <tei:ref target="http://zotero.org/groups/2552746/items/TJ5NT7TX"><tei:bibl>Roncalli 2008</tei:bibl></tei:ref>, the position of the inscriptions makes them readable, respectively, when the cup is used for drinking (<tei:rs corresp="#Fal_1_l_1" xml:lang="xfa-Ital-x-xfafal">eko lartos</tei:rs>) and when it is used as a cover (<tei:rs corresp="#Fal_1_l_2" xml:lang="xfa-Ital-x-xfafal">eko kaisiosio</tei:rs>). Such a configuration is probably used to mean a particular symposiac relationship between the two people named</tei:p>
                </tei:note>  
                <tei:listPerson type="Onomastics">
                        <tei:person xml:id="p1" xml:lang="xfa-Ital-x-xfafal">
                            <tei:persName>
                                <tei:name type="praenomen">lartos</tei:name>
                            </tei:persName>
                        </tei:person>
                        <tei:person xml:id="p2" xml:lang="xfa-Ital-x-xfafal">
                            <tei:persName>
                                <tei:name type="praenomen">kaisiosio</tei:name>
                            </tei:persName>
                        </tei:person>
                 </tei:listPerson>
            </tei:div>
